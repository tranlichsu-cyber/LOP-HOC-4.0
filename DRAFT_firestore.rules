rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Denial of all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Global student lookup (readonly for authenticated students/teachers)
    match /edupro_students/{studentId} {
      allow get: if true; // Allow lookup for login
      allow read, write: if isSignedIn(); // Teachers can manage
    }
    
    // Schools and related data
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Add admin check here
      
      match /classes/{classId} {
         allow read, write: if isSignedIn();
         
         match /homework/{hwId} {
           allow read, write: if isSignedIn();
         }
         
         match /students/{sId} {
            allow read, write: if isSignedIn();
         }
      }
    }
    
    match /teachers/{teacherId}/{allSegments=**} {
      allow read, write: if isOwner(teacherId);
    }
  }
}
