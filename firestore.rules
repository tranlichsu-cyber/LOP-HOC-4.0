rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isGlobalAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "tranlichsu@gmail.com" || request.auth.token.email == "tienganhltt@thainguyen.edu.vn");
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isSchoolAdmin(schoolId) {
      return hasRole('admin') && getUserData().schoolId == schoolId;
    }

    // ===============================================================
    // User Rules
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isGlobalAdmin() || 
                     (isAuthenticated() && request.auth.uid == userId) ||
                     (request.resource.data.schoolId != null && isSchoolAdmin(request.resource.data.schoolId));
      allow update, delete: if isGlobalAdmin() || 
                            (isAuthenticated() && request.auth.uid == userId) ||
                            (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId));
    }

    // ===============================================================
    // School Rules
    // ===============================================================
    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isGlobalAdmin() || isSchoolAdmin(schoolId);

      match /classes/{classId} {
        allow read: if isAuthenticated();
        allow write: if isGlobalAdmin() || isSchoolAdmin(schoolId);

        match /students/{studentId} {
          allow read: if isAuthenticated();
          allow write: if isGlobalAdmin() || isSchoolAdmin(schoolId) || (hasRole('teacher') && getUserData().schoolId == schoolId);
        }
      }

      match /departments/{departmentId} {
        allow read: if isAuthenticated();
        allow write: if isGlobalAdmin() || isSchoolAdmin(schoolId);
      }
    }

    // Legacy rules for compatibility during transition
    match /artifacts/edupro-app/users/{userId}/edupro_app/mainData {
      allow read, write: if isGlobalAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    match /teachers/{teacherId} {
      allow read, write: if isGlobalAdmin() || (isAuthenticated() && request.auth.uid == teacherId);
      match /{allSubcollections=**} {
        allow read, write: if isGlobalAdmin() || (isAuthenticated() && request.auth.uid == teacherId);
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if isGlobalAdmin();
    }
  }
}
