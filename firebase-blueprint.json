{
  "entities": {
    "UserProfile": {
      "title": "Người dùng",
      "description": "Thông tin hồ sơ giáo viên hoặc quản trị viên",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["teacher", "school_admin", "principal", "parent", "student"] },
        "schoolId": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Student": {
      "title": "Học sinh",
      "description": "Thông tin học sinh để đăng nhập mã định danh",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentName": { "type": "string" },
        "passHash": { "type": "string" },
        "schoolId": { "type": "string" },
        "classId": { "type": "string" },
        "teacherUid": { "type": "string" },
        "xp": { "type": "number" },
        "level": { "type": "number" }
      },
      "required": ["id", "studentName", "passHash"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Hồ sơ người dùng"
    },
    "/edupro_students/{studentId}": {
      "schema": "Student",
      "description": "Danh mục học sinh tra cứu toàn cục"
    }
  }
}
